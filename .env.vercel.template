# Environment Variables untuk Vercel Deployment
# Copy values ini ke Vercel saat deploy

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ImageKit Configuration  
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
VITE_IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

# ⚠️ IMPORTANT:
# 1. Jangan commit file ini ke GitHub (sudah di .gitignore)
# 2. Copy values di atas ke Vercel Environment Variables
# 3. Ganti "your-xxx" dengan values asli dari Supabase & ImageKit dashboard
